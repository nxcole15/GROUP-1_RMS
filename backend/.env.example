# Database Configuration
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=smart_student_service

# Auth / JWT (must match between login + middleware; set strong values in production)
JWT_SECRET=your-student-jwt-secret-here
JWT_EXPIRES_IN=24h
ADMIN_JWT_SECRET=your-admin-jwt-secret-here
TEACHER_JWT_SECRET=your-teacher-jwt-secret-here
NODE_ENV=development

# Email Configuration (Resend — SMTP_* is legacy and no longer used)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="CFEI INFORM System" <your_email@gmail.com>

 # Cloudinary Configuration for Student Photos
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Optional: Client origin(s) for CORS, comma-separated
# CLIENT_ORIGIN=http://localhost:3000
